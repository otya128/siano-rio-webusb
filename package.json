{
  "name": "siano-rio-webusb",
  "version": "0.1.0",
  "description": "TypeScript WebUSB driver for Siano Rio (SMS2270) ISDB-T receivers, ported from the Linux smsusb/smscore/smsdvb drivers",
  "type": "module",
  "license": "GPL-3.0-only",
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.demo.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "npm run typecheck && vite build",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "mpegts.js": "^1.8.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
